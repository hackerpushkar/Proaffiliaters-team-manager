# ============================================================================
# Proaffiliaters Team & Task Manager — Environment Configuration (.env.example)
# ============================================================================

# Network & Server Port (Default: 3050)
PORT=3050
NODE_ENV=production

# MongoDB Database Connection URI
# Local VPS MongoDB: mongodb://127.0.0.1:27017/proaffiliaters_tasks
# MongoDB Atlas Cloud: mongodb+srv://<username>:<password>@cluster0.mongodb.net/proaffiliaters_tasks?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/proaffiliaters_tasks

# Application Base URL
NEXT_PUBLIC_APP_URL=https://task.proaffiliaters.com

# Authentication & Session Secrets (Generate via 'openssl rand -base64 32')
JWT_SECRET=proaffiliaters_task_manager_jwt_secret_key_2026
SESSION_SECRET=proaffiliaters_super_admin_session_secret_2026
